{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildable.local/schemas/block-registry.schema.json",
  "title": "Buildable Block Registry",
  "type": "object",
  "required": ["version", "purpose", "blocks"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "target", "role", "fitsArchetypes", "fitsDesignProfiles", "tags", "needs", "references"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "target": { "enum": ["web", "mobile"] },
          "role": { "type": "string", "minLength": 1 },
          "fitsArchetypes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "fitsDesignProfiles": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "tags": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "needs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "references": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
