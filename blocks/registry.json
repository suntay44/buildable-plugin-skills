      "needs": ["empty copy", "recovery action", "filtered-empty variant"],
      "references": ["blocks/web/empty-state/BLOCK.md", "knowledge/ui-patterns/empty-states.md"]
    },
    {
      "id": "mobile/list-with-filters",
      "name": "Mobile List With Filters",
      "target": "mobile",
      "role": "entity-list",
      "fitsArchetypes": ["task-manager", "habit-tracker", "booking", "expense-tracker", "travel-planner", "field-service", "subscription-tracker"],
