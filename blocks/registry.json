    {
      "id": "mobile/empty-state",
      "name": "Mobile Empty State",
      "target": "mobile",
      "role": "state-coverage",
      "fitsArchetypes": ["task-manager", "habit-tracker", "booking", "expense-tracker", "travel-planner", "meal-planner", "field-service", "subscription-tracker"],
      "fitsDesignProfiles": ["mobile-utility"],
      "tags": ["empty", "offline", "filtered empty", "mobile state"],
      "needs": ["small-screen copy", "recovery action", "offline/local fallback"],
      "references": ["blocks/mobile/empty-state/BLOCK.md", "knowledge/ui-patterns/empty-states.md"]
