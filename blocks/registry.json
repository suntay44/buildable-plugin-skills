      "references": ["blocks/web/stat-card-grid/BLOCK.md", "knowledge/ui-patterns/charts.md"]
    },
    {
      "id": "web/entity-form",
      "name": "Entity Form",
      "target": "web",
      "role": "create-edit",
      "fitsArchetypes": ["crm", "task-manager", "notes", "blog-cms", "ecommerce-admin", "inventory-manager", "job-board"],
      "fitsDesignProfiles": ["operator-dashboard", "focused-productivity"],
      "tags": ["form", "create", "edit", "validation", "save"],
      "needs": ["entity fields", "validation states", "save/cancel actions"],
      "references": ["blocks/web/entity-form/BLOCK.md", "knowledge/ui-patterns/forms.md"]
    },
    {
      "id": "web/empty-state",
      "name": "Workflow Empty State",
      "target": "web",
      "role": "state-coverage",
      "fitsArchetypes": ["crm", "task-manager", "notes", "dashboard", "marketplace", "ecommerce-admin", "inventory-manager", "job-board", "blog-cms"],
