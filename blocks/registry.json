{
  "$schema": "./schema/block-registry.schema.json",
  "version": "0.1.0",
  "purpose": "Reusable Buildable micro-blocks selected during planning. Blocks are guidance and examples, not automatic code composition.",
  "blocks": [
    {
      "id": "web/filterable-table",
      "name": "Filterable Table",
      "target": "web",
      "role": "entity-list",
      "fitsArchetypes": ["crm", "dashboard", "ecommerce-admin", "inventory-manager", "job-board", "blog-cms"],
      "fitsDesignProfiles": ["operator-dashboard", "marketplace-catalog"],
      "tags": ["table", "filters", "search", "sort", "status", "dense list"],
      "needs": ["primary entity with status/category/date fields", "6+ realistic records"],
      "references": ["blocks/web/filterable-table/BLOCK.md", "knowledge/ui-patterns/tables.md", "knowledge/ui-patterns/filters.md"]
    },
    {
      "id": "web/detail-panel",
      "name": "Detail Panel",
      "target": "web",
      "role": "entity-detail",
      "fitsArchetypes": ["crm", "ecommerce-admin", "inventory-manager", "job-board", "notes", "real-estate"],
      "fitsDesignProfiles": ["operator-dashboard", "focused-productivity"],
      "tags": ["detail", "drawer", "side panel", "selected record", "metadata"],
      "needs": ["selected entity", "primary and secondary fields", "clear edit or next action"],
      "references": ["blocks/web/detail-panel/BLOCK.md", "knowledge/ui-patterns/action-bars.md", "knowledge/ui-patterns/forms.md"]
    },
    {
      "id": "web/stat-card-grid",
      "name": "Stat Card Grid",
      "target": "web",
      "role": "summary",
      "fitsArchetypes": ["crm", "dashboard", "ecommerce-admin", "inventory-manager", "subscription-tracker"],
