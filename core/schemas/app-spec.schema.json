{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildable.local/schemas/app-spec.schema.json",
  "title": "Buildable App Spec",
  "description": "The app spec returned by `buildable plan` and read by the agent. Stable public contract as of Buildable 1.0: fields may be added in minor/patch releases, but existing field names are not renamed or removed without a major (2.0) release.",
  "type": "object",
  "required": [
    "name",
    "target",
    "archetype",
    "complexity",
    "stack",
    "screens",
    "entities",
    "features",
    "sampleData",
    "mockData",
    "style",
    "designSystem",
    "blocks",
    "template",
    "templateStatus",
    "generationMode",
    "expectedFiles",
    "dataMode",
    "persistence",
    "nextStep",
    "references",
    "referenceInputs",
    "referenceLoadingContract",
    "mustNotInclude",
    "acceptanceCriteria",
    "questionsNeeded",
    "questions",
    "planAudit",
    "promptRefinement",
    "localOnly"
  ],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "target": { "enum": ["web", "mobile"] },
    "archetype": { "type": "string", "minLength": 1 },
    "complexity": { "type": "string", "minLength": 1 },
    "stack": { "type": "object" },
    "screens": { "type": "array", "minItems": 1 },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "fields"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "fields": { "type": "array", "minItems": 4, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "features": { "type": "array", "minItems": 1 },
    "sampleData": { "type": "string", "minLength": 1 },
    "mockData": {
      "type": "object",
      "required": ["strategy", "recordsPerEntity", "rules", "entities", "requiredStates"],
      "properties": {
        "strategy": { "type": "string", "minLength": 1 },
        "recordsPerEntity": { "type": "string", "minLength": 1 },
        "rules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "entities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "minimumRecords", "fieldsToPopulate"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "minimumRecords": { "type": "number", "minimum": 1 },
              "fieldsToPopulate": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "requiredStates": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "style": { "type": "string", "minLength": 1 },
    "designSystem": {
      "type": "object",
      "required": [
        "profile",
        "styleName",
        "visualTone",
        "palette",
        "typography",
        "density",
        "layoutRules",
        "componentRules",
        "motion",
        "accessibility",
        "avoid"
      ],
      "properties": {
        "profile": { "type": "string", "minLength": 1 },
        "styleName": { "type": "string", "minLength": 1 },
        "visualTone": { "type": "string", "minLength": 1 },
        "palette": {
          "type": "object",
          "required": ["intent"],
          "properties": {
            "intent": { "type": "string", "minLength": 1 },
            "primary": { "type": "string" },
            "accent": { "type": "string" },
            "status": { "type": "array", "items": { "type": "string" } }
          }
        },
        "typography": {
          "type": "object",
          "required": ["mood"],
          "properties": {
            "mood": { "type": "string", "minLength": 1 },
            "scale": { "type": "string" }
          }
        },
        "density": { "type": "string", "minLength": 1 },
        "layoutRules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "componentRules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "motion": { "type": "string", "minLength": 1 },
        "accessibility": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "avoid": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "template": { "type": "string", "minLength": 1 },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "role", "target", "reason", "needs", "references"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "target": { "enum": ["web", "mobile"] },
          "reason": { "type": "string", "minLength": 1 },
          "needs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "references": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "templateStatus": { "enum": ["planned", "starter", "runnable"] },
    "generationMode": { "enum": ["runnable-starter", "plan-only"] },
    "expectedFiles": { "type": "array", "items": { "type": "string" } },
    "dataMode": { "type": "string" },
    "starter": { "type": "string", "description": "Path to the starter source for runnable templates; omitted for planned-only templates." },
    "persistence": {
      "type": ["object", "null"],
      "description": "Opt-in local-first persistence plan, or null when the prompt did not ask to save/persist data.",
      "properties": {
        "requested": { "type": "boolean" },
        "defaultLayer": { "type": "string" },
        "vendorNeutral": { "type": "boolean" },
        "userNamedBackend": { "type": ["string", "null"] },
        "references": { "type": "array", "items": { "type": "string" } },
        "rule": { "type": "string" }
      }
    },
    "nextStep": { "type": "string" },
    "references": { "type": "array", "items": { "type": "string" } },
    "referenceInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "absolutePath", "name", "kind", "exists", "inspectInstruction"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "absolutePath": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["image", "screenshot", "document", "source", "file"] },
          "exists": { "type": "boolean" },
          "sizeBytes": { "type": ["number", "null"] },
          "inspectInstruction": { "type": "string", "minLength": 1 }
        }
      }
    },
    "referenceLoadingContract": {
      "type": "array",
      "prefixItems": [
        { "const": "Do not load all templates." },
        { "const": "Run buildable plan." },
        { "const": "Load only appSpec.references." },
        { "const": "Load starter source only for the selected template." }
      ],
      "minItems": 4
    },
    "auth": {
      "type": ["object", "null"],
      "required": ["requested", "defaultMode", "vendorNeutral", "userNamedProvider", "references", "states", "rule"],
      "properties": {
        "requested": { "type": "boolean" },
        "defaultMode": { "enum": ["local-mock", "provider-behind-seam"] },
        "vendorNeutral": { "type": "boolean" },
        "userNamedProvider": { "type": ["string", "null"] },
        "references": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "states": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "rule": { "type": "string", "minLength": 1 }
      }
    },
    "mustNotInclude": { "type": "array", "items": { "type": "string" } },
    "acceptanceCriteria": { "type": "array", "minItems": 1 },
    "questionsNeeded": { "type": "boolean" },
    "questions": { "type": "array", "items": { "type": "string" } },
    "planAudit": {
      "type": "object",
      "required": ["mode", "instruction", "checks", "failurePolicy"],
      "properties": {
        "mode": { "const": "audit-first" },
        "instruction": { "type": "string", "minLength": 1 },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "status", "gate"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "minLength": 1 },
              "gate": { "type": "string", "minLength": 1 }
            }
          }
        },
        "failurePolicy": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "promptRefinement": {
      "type": "object",
      "required": ["mode", "instruction", "assumptions", "optionalQuestions", "nextPromptExample"],
      "properties": {
        "mode": { "enum": ["blocking-first", "optional"] },
        "instruction": { "type": "string", "minLength": 1 },
        "assumptions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "optionalQuestions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "question", "why", "defaultAnswer"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "question": { "type": "string", "minLength": 1 },
              "why": { "type": "string", "minLength": 1 },
              "defaultAnswer": { "type": "string", "minLength": 1 }
            }
          }
        },
        "nextPromptExample": { "type": "string", "minLength": 1 }
      }
    },
    "localOnly": { "const": true }
  }
}
