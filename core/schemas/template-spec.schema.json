{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildable.local/schemas/template-spec.schema.json",
  "title": "Buildable Template Spec",
  "type": "object",
  "required": ["name", "target", "archetype", "stack", "status", "references"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "target": { "enum": ["web", "mobile"] },
    "archetype": { "type": "string", "minLength": 1 },
    "stack": { "type": "object" },
    "status": { "enum": ["planned", "starter", "runnable"] },
    "starter": { "type": "string" },
    "references": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
